# ------------------------------------------------------------------
# AI Social Media SaaS — API environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Core ---
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# --- Database (MySQL) ---
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_ai_saas
# Optional: full override (takes priority over DB_* parts)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/social_ai_saas?charset=utf8mb4

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# --- Encryption for OAuth tokens at rest (optional; derived from JWT secret if unset) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AI_PRIMARY_PROVIDER=anthropic
AI_CACHE_TTL_SECONDS=300

# --- YouTube Data API v3 ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5000/api/social-accounts/connect/youtube/callback

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=

# --- Frontend origin (for billing redirect URLs) ---
FRONTEND_URL=http://localhost:3000
