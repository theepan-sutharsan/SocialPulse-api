# ------------------------------------------------------------------
# AI Social Media SaaS — API environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# --- Core ---
SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

# --- Database (MySQL) ---
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_ai_saas
# Optional: full override (takes priority over DB_* parts)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/social_ai_saas?charset=utf8mb4

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# --- Encryption for OAuth tokens at rest (optional; derived from JWT secret if unset) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI providers ---
ANTHROPIC_API_KEY=
# Use this provider by setting AI_PRIMARY_PROVIDER=openai below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini (AI Studio). Create a key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible chat completions.
# Get a key at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
# OpenRouter unified model API. Create a key at
# https://openrouter.ai/settings/keys and choose any supported model slug.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto-beta
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Social Pulse
# Primary is tried first; unset providers are skipped. Options: nvidia,
# openrouter, anthropic, openai, gemini.
AI_PRIMARY_PROVIDER=gemini
AI_CACHE_TTL_SECONDS=300

# --- YouTube Data API v3 ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5000/api/social-accounts/connect/youtube/callback
# API key for public channel tracking by URL/handle (no OAuth). Create at
# https://console.cloud.google.com → APIs & Services → Credentials.
YOUTUBE_API_KEY=

# --- Instagram Graph API (OAuth; Business/Creator accounts only) ---
# Instagram provides no public metrics API, so real data requires OAuth via a
# Meta app (https://developers.facebook.com). The account must be a Business or
# Creator account. Leave blank to use Demo Mode for Instagram.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_VERIFY_TOKEN=

# --- Billing ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=

# --- Frontend origin (for billing redirect URLs) ---
FRONTEND_URL=http://localhost:3000
